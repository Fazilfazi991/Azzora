{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/accounts-review.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pdfjs-dist/legacy/build/pdf.worker.mjs,@napi-rs/canvas-linux-x64-gnu/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/accounts-review/:route*",
      "destination": "/api/accounts-review?route=:route*"
    },
    { "source": "/", "destination": "/accountant.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
