{
  "name": "azzora-project-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:accounts": "vite --host 127.0.0.1 --port 5277",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run src tests",
    "test:portal-fixture": "node --test docs/finance/portal-design/finance-fixture.test.mjs",
    "test:accounts:browser": "node tests/accounts-review-browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:commercial:browser": "node tests/commercial-browser.mjs",
    "test:commercial:boundaries": "node tests/commercial-boundaries.mjs",
    "test:operational:browser": "node tests/operational-browser.mjs",
    "test:operational:boundaries": "node tests/operational-boundaries.mjs",
    "test:corrective:browser": "node tests/agent-1-corrective-browser.mjs",
    "test:boq:visual": "node tests/boq-visual.mjs",
    "format": "prettier --write src tests *.json *.ts *.js index.html",
    "test:quotations:browser": "node tests/quotation-browser.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
